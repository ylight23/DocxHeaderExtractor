      "sourceBlocks": [
        {
          "id": "body[1]/p[1]",
          "page": 0,
          "text": "Minutes from November 27, 2024 Meeting Governing Committee (GC) of the Facilitation of Resources to Invest in Strengthening Ukraine Financial Intermediary Fund (F.O.R.T.I.S. Ukraine FIF)"
        },
        {
          "id": "body[1]/p[3]",
          "page": 0,
          "text": "Opening:"
        },
        {
          "id": "body[1]/p[4]",
          "page": 0,
          "text": "The meeting was called to order at 7:00 am EST by Linda Van Gelder, acting as Chair, with participants joining remotely."
        },
        {
          "id": "body[1]/p[5]",
          "page": 0,
          "text": "Present:"
        },
        {
          "id": "body[1]/p[6]",
          "page": 0,
          "text": "Governing Committee: Philippe Hall (Canada); Masaya Hatoma, Shinichiro Kurasawa (Japan); Olga Zykova, Yuri Butsa (Ukraine); Brian McCauley, (United States)."
        },
        {
          "id": "body[1]/p[7]",
          "page": 0,
          "text": "Interim-Secretariat: Linda Van Gelder, Carolina Sanchez Paramo, Anthony Gaeta"
        },
        {
          "id": "body[1]/p[8]",
          "page": 0,
          "text": "Trustee: Traci Phillips, Ashish Makkar"
        },
        {
          "id": "body[1]/p[9]",
          "page": 0,
          "text": "World Bank Legal: Duncan Kiara, Maria Lourdes Pardo, Andrew Giddings"
        },
        {
          "id": "body[1]/p[11]",
          "page": 0,
          "text": "On November 27, 2024, the F.O.R.T.I.S. Ukraine FIF Governing Committee met to seek resolution on the areas identified as not provisionally approved during the First Governing Committee Meeting on November 21, 2024, related to Governance/Voting Rights."
        },
        {
          "id": "body[1]/p[12]",
          "page": 0,
          "text": "Governance/Voting Rights. The Governing Committee discussed and agreed in principle to language intended to seek resolution of the governance issues in a manner consistent with the fundamental principles of creating a FIF which is open to all World Bank members, treats them equitably, and is consistent with the multilateral approach to FIFs and development finance, while still meeting the needs of the original contributors to the F.O.R.T.I.S Ukraine FIF. The Meeting agreed that the Interim Secretariat would modify the relevant language in the Operations Manual and reflect the changes in the Governance Framework. With this agreement, the GC provisionally approved the full set of documents to establish the F.O.R.T.I.S. Ukraine FIF."
        },
        {
          "id": "body[1]/p[13]",
          "page": 0,
          "text": "It was agreed that all Voting Members would have until opening of business Monday December 2 (EST) to confirm their agreement, including the approach taken to finalizing editorial suggestions, after which the documents would be final."
        },
        {
          "id": "body[1]/p[14]",
          "page": 0,
          "text": "Subsequent Note: On or before December 2, 2024, representatives of all three Voting Members provided their agreement to the pre-final versions of the documents circulated by the Secretariat on November 21, 2024. Hence, the Standard Provisions to the Contribution Agreement/Arrangement, Financial Procedures Agreement Template, Governance Framework, Operations Manual, and Funding Request Template are finalized and adopted by the Governing Committee as of December 2, 2024."
        },
        {
          "id": "body[1]/p[15]",
          "page": 0,
          "text": "For the Funding Request Template, language will be proposed by Ukraine on the process for endorsing proposals and will be inserted accordingly after the Voting Members are informed."
        }
      ],
      "selectedSourceBlocks": [
        {
          "id": "body[1]/p[1]",
          "page": 0,
          "text": "Minutes from November 27, 2024 Meeting Governing Committee (GC) of the Facilitation of Resources to Invest in Strengthening Ukraine Financial Intermediary Fund (F.O.R.T.I.S. Ukraine FIF)"
        },
        {
          "id": "body[1]/p[3]",
          "page": 0,
          "text": "Opening:"
        },
        {
          "id": "body[1]/p[4]",
          "page": 0,
          "text": "The meeting was called to order at 7:00 am EST by Linda Van Gelder, acting as Chair, with participants joining remotely."
        },
        {
          "id": "body[1]/p[5]",
          "page": 0,
          "text": "Present:"
        },
        {
          "id": "body[1]/p[6]",
          "page": 0,
          "text": "Governing Committee: Philippe Hall (Canada); Masaya Hatoma, Shinichiro Kurasawa (Japan); Olga Zykova, Yuri Butsa (Ukraine); Brian McCauley, (United States)."
        },
        {
          "id": "body[1]/p[7]",
          "page": 0,
          "text": "Interim-Secretariat: Linda Van Gelder, Carolina Sanchez Paramo, Anthony Gaeta"
        },
        {
          "id": "body[1]/p[8]",
          "page": 0,
          "text": "Trustee: Traci Phillips, Ashish Makkar"
        },
        {
          "id": "body[1]/p[9]",
          "page": 0,
          "text": "World Bank Legal: Duncan Kiara, Maria Lourdes Pardo, Andrew Giddings"
        },
        {
          "id": "body[1]/p[11]",
          "page": 0,
          "text": "On November 27, 2024, the F.O.R.T.I.S. Ukraine FIF Governing Committee met to seek resolution on the areas identified as not provisionally approved during the First Governing Committee Meeting on November 21, 2024, related to Governance/Voting Rights."
        },
        {
          "id": "body[1]/p[12]",
          "page": 0,
          "text": "Governance/Voting Rights. The Governing Committee discussed and agreed in principle to language intended to seek resolution of the governance issues in a manner consistent with the fundamental principles of creating a FIF which is open to all World Bank members, treats them equitably, and is consistent with the multilateral approach to FIFs and development finance, while still meeting the needs of the original contributors to the F.O.R.T.I.S Ukraine FIF. The Meeting agreed that the Interim Secretariat would modify the relevant language in the Operations Manual and reflect the changes in the Governance Framework. With this agreement, the GC provisionally approved the full set of documents to establish the F.O.R.T.I.S. Ukraine FIF."
        },
        {
          "id": "body[1]/p[13]",
          "page": 0,
          "text": "It was agreed that all Voting Members would have until opening of business Monday December 2 (EST) to confirm their agreement, including the approach taken to finalizing editorial suggestions, after which the documents would be final."
        },
        {
          "id": "body[1]/p[14]",
          "page": 0,
          "text": "Subsequent Note: On or before December 2, 2024, representatives of all three Voting Members provided their agreement to the pre-final versions of the documents circulated by the Secretariat on November 21, 2024. Hence, the Standard Provisions to the Contribution Agreement/Arrangement, Financial Procedures Agreement Template, Governance Framework, Operations Manual, and Funding Request Template are finalized and adopted by the Governing Committee as of December 2, 2024."
        },
        {
          "id": "body[1]/p[15]",
          "page": 0,
          "text": "For the Funding Request Template, language will be proposed by Ukraine on the process for endorsing proposals and will be inserted accordingly after the Voting Members are informed."
        }
      ],
