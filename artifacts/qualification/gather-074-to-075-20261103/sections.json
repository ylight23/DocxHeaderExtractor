  "sections": [
    {
      "Heading": "Opening:",
      "TargetLocation": "body[1]/p[4]",
      "NextHeadingLocation": "body[1]/p[5]",
      "complete": true,
      "facts": [
        {
          "text": "The meeting was called to order at 7:00 am EST by Linda Van Gelder, acting as Chair, with participants joining remotely.",
          "Flags": [
            "PATH_UNCERTAIN"
          ],
          "sources": [
            "074 body[1]/p[3]"
          ]
        },
        {
          "text": "Agreement/Arrangement, Financial Procedures Agreement Template, Governance Framework, Operations Manual, and Funding Request Template are finalized and adopted by the Governing Committee as of December 2, 2024.",
          "Flags": [
            "PATH_UNCERTAIN"
          ],
          "sources": [
            "074 body[1]/p[13]"
          ]
        },
        {
          "text": "For the Funding Request Template, language will be proposed by Ukraine on the process for endorsing proposals and will be inserted accordingly after the Voting Members are informed.",
          "Flags": [
            "PATH_UNCERTAIN"
          ],
          "sources": [
            "074 body[1]/p[14]"
          ]
        }
      ],
      "refused": [],
      "failures": [],
      "conflicts": []
    },
    {
      "Heading": "Present:",
      "TargetLocation": "body[1]/p[5]",
      "NextHeadingLocation": "body[1]/p[11]",
      "complete": true,
      "facts": [
        {
          "text": "Governing Committee: Philippe Hall (Canada); Masaya Hatoma, Shinichiro Kurasawa (Japan); Olga Zykova, Yuri Butsa (Ukraine); Brian McCauley, (United States).",
          "Flags": [
            "PATH_UNCERTAIN"
          ],
          "sources": [
            "074 body[1]/p[5]"
          ]
        },
        {
          "text": "Interim-Secretariat: Linda Van Gelder, Carolina Sanchez Paramo, Anthony Gaeta",
          "Flags": [
            "PATH_UNCERTAIN"
          ],
          "sources": [
            "074 body[1]/p[6]"
          ]
        },
        {
          "text": "Trustee: Traci Phillips, Ashish Makkar",
          "Flags": [
            "PATH_UNCERTAIN"
          ],
          "sources": [
            "074 body[1]/p[7]"
          ]
        },
        {
          "text": "World Bank Legal: Duncan Kiara, Maria Lourdes Pardo, Andrew Giddings",
          "Flags": [
            "PATH_UNCERTAIN"
          ],
          "sources": [
            "074 body[1]/p[8]"
          ]
        }
      ],
      "refused": [],
      "failures": [],
      "conflicts": []
    },
    {
      "Heading": "Item 1: Document Approval.",
      "TargetLocation": "body[1]/p[11]",
      "NextHeadingLocation": "body[1]/p[24]",
      "complete": true,
      "facts": [
        {
          "text": "With this agreement, the GC provisionally approved the full set of documents to establish the F.O.R.T.I.S. Ukraine FIF.",
          "Flags": [
            "PATH_UNCERTAIN"
          ],
          "sources": [
            "074 body[1]/p[10]"
          ]
        },
        {
          "text": "It was agreed that all Voting Members would have until opening of business Monday December 2 (EST) to confirm their agreement",
          "Flags": [
            "PATH_UNCERTAIN"
          ],
          "sources": [
            "074 body[1]/p[11]"
          ]
        },
        {
          "text": "On or before December 2, 2024, representatives of all three Voting Members provided their agreement to the pre-final versions of the documents circulated by the Secretariat",
          "Flags": [
            "PATH_UNCERTAIN"
          ],
          "sources": [
            "074 body[1]/p[12]"
          ]
        },
        {
          "text": "Agreement/Arrangement, Financial Procedures Agreement Template, Governance Framework, Operations Manual, and Funding Request Template are finalized and adopted by the Governing Committee as of December 2, 2024.",
          "Flags": [
            "PATH_UNCERTAIN"
          ],
          "sources": [
            "074 body[1]/p[13]"
          ]
        },
        {
          "text": "For the Funding Request Template, language will be proposed by Ukraine on the process for endorsing proposals and will be inserted accordingly after the Voting Members are informed.",
          "Flags": [
            "PATH_UNCERTAIN"
          ],
          "sources": [
            "074 body[1]/p[14]"
          ]
        }
      ],
      "refused": [],
      "failures": [],
      "conflicts": []
