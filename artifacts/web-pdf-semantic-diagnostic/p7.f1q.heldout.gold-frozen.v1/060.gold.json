    },
    {
      "sourceAlias": "L0810:S0",
      "page": 21,
      "pageStratum": "SEEDED_INTERIOR",
      "text": "Repe(1) ⊗e(2) ...⊗e(N) : V1 ⊗ V2 ... ⊗ VN → Kn1 ⊗ Kn2 ... ⊗ KnN (57)",
      "label": "OTHER",
      "goldStatus": "LABELED"
    },
    {
      "sourceAlias": "L0811:S0",
      "page": 21,
      "pageStratum": "SEEDED_INTERIOR",
      "text": "which maps each basis vectors e(1)i1 ⊗ e(2)i2 ... ⊗ e(N)iN ∈ V1 ⊗ V2 ... ⊗ VN into",
