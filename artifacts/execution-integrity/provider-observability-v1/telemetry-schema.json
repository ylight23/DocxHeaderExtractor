{
  "schemaVersion": "provider-observability-v1",
  "records": [
    "logical-call.started.\u003Cid\u003E.json",
    "attempt.started.\u003Cid\u003E.json",
    "response.raw.\u003CattemptId\u003E.txt",
    "response.parsed.\u003CattemptId\u003E.json",
    "response.binding.\u003CattemptId\u003E.json",
    "events.jsonl",
    "heartbeats.jsonl"
  ],
  "milestones": [
    "TRANSPORT_START",
    "CONNECTION_ESTABLISHED",
    "REQUEST_HEADERS_SENT",
    "REQUEST_BODY_SENT",
    "RESPONSE_HEADERS_RECEIVED",
