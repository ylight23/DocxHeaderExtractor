    {
      "sourceId": "body[1]/p[9]",
      "sourceOrdinal": 8,
      "rawText": "On November 27, 2024, the F.O.R.T.I.S. Ukraine FIF Governing Committee met to seek resolution on the areas identified as not provisionally approved during the First Governing Committee Meeting on November 21, 2024, related to Governance/Voting Rights.",
      "fullSpan": {
        "start": 0,
        "end": 251
      },
      "style": {
        "styleId": "Normal",
        "styleName": "Normal",
        "builtInHeadingStyleLevel": null,
        "outlineLevel": null,
        "bold": false,
        "italic": false,
        "underline": false,
        "allCaps": false,
        "fontSizePt": 12,
        "alignment": "both"
      },
      "numbering": {
        "numberingId": null,
        "numberingLevel": null,
        "numberLabel": null,
