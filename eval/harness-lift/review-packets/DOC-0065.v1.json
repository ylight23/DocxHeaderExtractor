    },
    {
      "sourceId": "body[1]/p[12]",
      "sourceOrdinal": 11,
      "rawText": "Report on Currently Available Resources in the F.O.R.T.I.S. Ukraine FIF. The Trustee confirmed that as of February 28, 2026, $1,310.42 million is available for new commitments.",
      "fullSpan": {
        "start": 0,
        "end": 176
      },
      "style": {
        "styleId": "Normal",
        "styleName": "Normal",
        "builtInHeadingStyleLevel": null,
        "outlineLevel": null,
        "bold": false,
        "italic": false,
        "underline": false,
        "allCaps": false,
        "fontSizePt": 12,
        "alignment": "left"
      },
      "numbering": {
        "numberingId": null,
        "numberingLevel": null,
        "numberLabel": null,
        "numberingFormat": null,
        "numberingStyleHeadingLevel": null
      },
      "layout": {
