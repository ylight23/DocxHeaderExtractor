    {
      "sourceParts": [
        {
          "sourceAlias": "L1591:S0",
          "verbatimText": "11.2.4. Stream Types"
        }
      ],
      "semanticFunction": "REGION_STRUCTURE"
    },
    {
      "sourceParts": [
        {
          "sourceAlias": "L1592:S0",
          "verbatimText": "This document establishes a registry for HTTP/3 unidirectional stream types. The \"HTTP/3 Stream"
        },
        {
          "sourceAlias": "L1593:S0",
          "verbatimText": "Types\" registry governs a 62-bit space. This registry follows the QUIC registry policy; see Section"
        },
        {
          "sourceAlias": "L1594:S0",
          "verbatimText": "11.2. Permanent registrations in this registry are assigned using the Specification Required policy"
        },
        {
          "sourceAlias": "L1595:S0",
          "verbatimText": "([RFC8126]), except for values between 0x00 and 0x3f (in hexadecimal; inclusive), which are"
        },
        {
          "sourceAlias": "L1596:S0",
          "verbatimText": "assigned using Standards Action or IESG Approval as defined in Sections 4.9 and 4.10 of [RFC8126]."
        }
      ],
      "semanticFunction": "BODY_INFORMATION"
    },
    {
      "sourceParts": [
        {
          "sourceAlias": "L1597:S0",
          "verbatimText": "In addition to common fields as described in Section 11.2, permanent registrations in this registry"
        },
        {
          "sourceAlias": "L1598:S0",
          "verbatimText": "MUST include the following fields:"
        }
      ],
      "semanticFunction": "BODY_INFORMATION"
    },
    {
      "sourceParts": [
        {
          "sourceAlias": "L1599:S0",
          "verbatimText": "Stream Type: A name or label for the stream type."
        }
      ],
      "semanticFunction": "BODY_INFORMATION"
    },
    {
      "sourceParts": [
        {
          "sourceAlias": "L1600:S0",
          "verbatimText": "Sender: Which endpoint on an HTTP/3 connection may initiate a stream ofthis type. Values are"
        },
        {
          "sourceAlias": "L1601:S0",
          "verbatimText": "\"Client\", \"Server\", or \"Both\"."
        }
      ],
      "semanticFunction": "BODY_INFORMATION"
    },
    {
      "sourceParts": [
        {
          "sourceAlias": "L1602:S0",
          "verbatimText": "Specifications for permanent registrations MUST include a description ofthe stream type,"
        },
        {
          "sourceAlias": "L1603:S0",
          "verbatimText": "including the layout and semantics ofthe stream contents."
        }
      ],
      "semanticFunction": "BODY_INFORMATION"
    },
    {
      "sourceParts": [
        {
          "sourceAlias": "L1604:S0",
          "verbatimText": "The entries in Table 5 are registered by this document."
        }
      ],
      "semanticFunction": "BODY_INFORMATION"
    },
    {
