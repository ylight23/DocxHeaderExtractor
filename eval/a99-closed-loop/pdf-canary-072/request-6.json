:{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0809","text":". ,","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0810","text":"item lists allows each ICP region to produce regional PPPs that are more representative of their own consumption patterns: basing the global comparison on global core items alone would reduce that representativity It was also noted that while there can be advantages in choosing one method over another","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":3},"numbering":{},"markers":[],"attention":true},{"alias":"S0811","text":". ,","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0812","text":"the methodological consistency and maturity ofthe ICP achieved in recent cycles has enhanced the credibility","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":["marker-family:loose_labelled","marker-signature:label:the","marker-depth:1","marker-is-path:false"],"attention":true},{"alias":"S0813","text":"and uses of global PPPs Therefore while further methodological research is necessary any changes must be","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0814","text":". , ,","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0815","text":"carefully considered","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0816","text":".","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0817","text":"11","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0818","text":"6 Improving Reliability of Price Comparisons","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":true,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":["marker-family:arabic","marker-signature:Arabic:1","marker-depth:1","marker-is-path:true","marker-components:6"],"attention":true},{"alias":"S0819","text":".","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":true,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0820","text":"Professor Erwin Diewert University of British Columbia and University of New South Wales presented his","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0821","text":", ,","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0822","text":"paper on Basic Heading PPPs and the Lack of Matching Problem","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0823","text":".","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0824","text":"The paper analyses three alternative methods for the calculation of basic heading PPPs at the global level: i)","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0825","text":"\u201C \u201D","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0826","text":"the Country Product Dummy Method; ii) The Jevons Star Country Method and iii) the Jevons-GEKS Method","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0827","text":".","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0828","text":"\u201C \u201D","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0829","text":"In all these methods missing item prices affects the outcome of basic heading PPPs The lack of matching","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0830","text":", .","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0831","text":"problem occurs when a large portion of items within a basic heading is not priced by two or more regions","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0832","text":",","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0833","text":"which affects the reliability of PPPs The paper showcases this issue by presenting several examples taken","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0834","text":".","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0835","text":"from the ICP 2017 cycle","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0836","text":".","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0837","text":"An alternative solution would be through similarity linking choosing five pairs of countries between the five","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0838","text":",","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0839","text":"ICP regions with the highest matching price data between them The problem is that determining which pairs","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0840","text":".","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0841","text":"of countries would be optimal for interregional linking is a difficult task","owned":false},{"alias":"S0842","text":".","owned":false},{"alias":"S0843","text":"\u201C","owned":false},{"alias":"S0844","text":"Yuri Dikhanov World Bank presented a paper under the title Fisher versus T\u00F6rnqvist when Relative Price","owned":false},{"alias":"S0845","text":", ,","owned":false},{"alias":"S0846","text":"\u201D \u201C","owned":false},{"alias":"S0847","text":"Changes are Large and the foundation paper Range of possible results for certain classes of superlative","owned":false},{"alias":"S0848","text":"\u201D","owned":false},{"alias":"S0849","text":"price indices which establishes how superlative indices are different from each other","owned":false},{"alias":"S0850","text":".","owned":false},{"alias":"S0851","text":"The paper argues that the basic aggregation method used in the ICP (the Fisher-based GEKS) is unstable in the face of price and expenditure volatility and proposes using the T\u00F6rnqvist-based CCD (Caves Christensen","owned":false},{"alias":"S0852","text":",","owned":false},{"alias":"S0853","text":"and Diewert) index instead The paper analyses both spatial and temporal indices","owned":false},{"alias":"S0854","text":". .","owned":false},{"alias":"S0855","text":"For temporal analyses three types of indices are considered: (i) multilateral or GEKS (multilateral Fisher) and","owned":false},{"alias":"S0856","text":", ,","owned":false},{"alias":"S0857","text":"CCD (multilateral T\u00F6rnqvist) (ii) direct or 2023/1990 direct estimates using only two years and (iii) chained","owned":false},{"alias":"S0858","text":", , ,","owned":false},{"alias":"S0859","text":"indices These indices are used on two aggregation scopes: (i) over all items and (ii) over all items without","owned":false},{"alias":"S0860","text":". ,","owned":false}]}
