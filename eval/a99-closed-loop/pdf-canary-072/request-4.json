:0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0565","text":"In the discussion it was noticed how the adoption of the new classification will not necessarily affect the product list but rather the grouping of basic headings and further aggregates In addition it was noted how","owned":true,"scope":"document_body","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":2},"numbering":{},"markers":[],"attention":true},{"alias":"S0566","text":", . ,","owned":true,"scope":"table","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0567","text":"for ICP purposes the new SNA will likely have a limited impact","owned":true,"scope":"document_body","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0568","text":", .","owned":true,"scope":"table","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0569","text":"In conclusion the Group endorsed the proposal of establishing a Task Force for the adoption of the new COICOP classification and SNA while inviting to consider whether a revision of the product list would be","owned":true,"scope":"document_body","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":2},"numbering":{},"markers":[],"attention":true},{"alias":"S0570","text":",","owned":true,"scope":"table","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0571","text":"beneficial","owned":true,"scope":"document_body","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0572","text":".","owned":true,"scope":"table","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0573","text":"Session V: Current Research 1 The Treatment of Import and Export Prices in International Comparisons","owned":true,"scope":"document_body","tableDepth":0,"inTableOfContents":false,"style":{"Bold":true,"Italic":false,"RelativeFontSize":"body","LineCount":2},"numbering":{},"markers":["marker-family:labelled","marker-signature:Labelled(session):1","marker-depth:1","marker-is-path:false"],"attention":true},{"alias":"S0574","text":".","owned":true,"scope":"table","tableDepth":0,"inTableOfContents":false,"style":{"Bold":true,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0575","text":"Professor Robert Feenstra University of California-Davis and Professor Alberto Cavallo Harvard University","owned":true,"scope":"document_body","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0576","text":", ,","owned":true,"scope":"table","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0577","text":"presented research on assessing different methods for the estimation of PPPs for imports and exports It","owned":true,"scope":"document_body","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0578","text":".","owned":true,"scope":"table","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0579","text":"compared the use of nominal exchange rates vs quality-adjusted unit values for estimating PPPs and the use","owned":true,"scope":"document_body","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0580","text":"8","owned":true,"scope":"table","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0581","text":"of Artificial Intelligence (AI) technologies to source import prices and identify the country of origin for","owned":true,"scope":"document_body","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0582","text":"products","owned":true,"scope":"document_body","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0583","text":".","owned":true,"scope":"table","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0584","text":"Professor Feenstra presented the empirical findings of an analysis aimed at simplifying the current","owned":true,"scope":"document_body","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0585","text":"methodology used by the Penn World Tables for estimating imports and exports PPPs The results showed","owned":true,"scope":"document_body","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0586","text":".","owned":true,"scope":"table","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0587","text":"how the use of nominal exchange rates which is the current ICP methodological approach while introducing","owned":true,"scope":"document_body","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0588","text":", ,","owned":true,"scope":"table","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0589","text":"a small systematic downward bias in the estimation of price levels provides close estimates to the measure","owned":true,"scope":"document_body","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0590","text":",","owned":true,"scope":"table","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0591","text":"of real GDP on the output side and constitutes the preferred method going forward","owned":true,"scope":"document_body","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0592","text":".","owned":true,"scope":"table","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0593","text":"Professor Cavallo discussed the potential of AI technologies such as ChatGPT to enhance price collection","owned":true,"scope":"document_body","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0594","text":", ,","owned":true,"scope":"table","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0595","text":"and classification He presented the findings of his research testing the ability of Large Language Models","owned":true,"scope":"document_body","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0596","text":".","owned":true,"scope":"table","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0597","text":"(LLMs) to identify whether a good is imported and the country of origin The findings highlight how modern","owned":true,"scope":"document_body","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0598","text":".","owned":true,"scope":"table","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0599","text":"search models can determine whether a product is domestic or imported with approximately 80% accuracy","owned":true,"scope":"document_body","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0600","text":".","owned":true,"scope":"table","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0601","text":"Predicting the specific country of origin is more challenging with the interactive version of ChatGPT achieving","owned":false},{"alias":"S0602","text":",","owned":false},{"alias":"S0603","text":"approximately 70% accuracy","owned":false},{"alias":"S0604","text":".","owned":false},{"alias":"S0605","text":"The ensuing discussion centered on the potential uses of LLMs and their limitations in official price statistics","owned":false},{"alias":"S0606","text":".","owned":false},{"alias":"S0607","text":"\u201C \u201D","owned":false},{"alias":"S0608","text":"While the tendency of the existing models to hallucinate undermines their reliability their future potential","owned":false},{"alias":"S0609","text":",","owned":false},{"alias":"S0610","text":"should be considered for tasks of triangulation of information and data validation","owned":false},{"alias":"S0611","text":".","owned":false},{"alias":"S0612","text":"In conclusion TAG recognized the relevance of this research both in relation to some of the immediate","owned":false},{"alias":"S0613","text":",","owned":false},{"alias":"S0614","text":"questions the ICP methodology is facing as well as more long-term developments such as the use of AI technology for price collection and validation","owned":false},{"alias":"S0615","text":".","owned":false},{"alias":"S0616","text":"2 A Survey Based Approach to Adjustment for Quality Differences in Services in International Price","owned":false},{"alias":"S0617","text":".","owned":false},{"alias":"S0618","text":"Comparisons","owned":false},{"alias":"S0619","text":"Professor Naohito Abe Hitotsubashi University presented a research paper written in collaboration with","owned":false},{"alias":"S0620","text":", ,","owned":false}]}
