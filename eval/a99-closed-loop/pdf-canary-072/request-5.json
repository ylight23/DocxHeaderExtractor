lias":"S0591","text":"of real GDP on the output side and constitutes the preferred method going forward","owned":false},{"alias":"S0592","text":".","owned":false},{"alias":"S0593","text":"Professor Cavallo discussed the potential of AI technologies such as ChatGPT to enhance price collection","owned":false},{"alias":"S0594","text":", ,","owned":false},{"alias":"S0595","text":"and classification He presented the findings of his research testing the ability of Large Language Models","owned":false},{"alias":"S0596","text":".","owned":false},{"alias":"S0597","text":"(LLMs) to identify whether a good is imported and the country of origin The findings highlight how modern","owned":false},{"alias":"S0598","text":".","owned":false},{"alias":"S0599","text":"search models can determine whether a product is domestic or imported with approximately 80% accuracy","owned":false},{"alias":"S0600","text":".","owned":false},{"alias":"S0601","text":"Predicting the specific country of origin is more challenging with the interactive version of ChatGPT achieving","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0602","text":",","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0603","text":"approximately 70% accuracy","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0604","text":".","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0605","text":"The ensuing discussion centered on the potential uses of LLMs and their limitations in official price statistics","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0606","text":".","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0607","text":"\u201C \u201D","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0608","text":"While the tendency of the existing models to hallucinate undermines their reliability their future potential","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0609","text":",","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0610","text":"should be considered for tasks of triangulation of information and data validation","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0611","text":".","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0612","text":"In conclusion TAG recognized the relevance of this research both in relation to some of the immediate","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0613","text":",","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0614","text":"questions the ICP methodology is facing as well as more long-term developments such as the use of AI technology for price collection and validation","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":2},"numbering":{},"markers":[],"attention":true},{"alias":"S0615","text":".","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0616","text":"2 A Survey Based Approach to Adjustment for Quality Differences in Services in International Price","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":true,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":["marker-family:arabic","marker-signature:Arabic:1","marker-depth:1","marker-is-path:true","marker-components:2"],"attention":true},{"alias":"S0617","text":".","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":true,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0618","text":"Comparisons","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":true,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0619","text":"Professor Naohito Abe Hitotsubashi University presented a research paper written in collaboration with","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0620","text":", ,","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0621","text":"Professor Kyoji Fukao Dr Kenta Ikeuchi and Professor D S Prasada Rao on the topic of price adjustments","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0622","text":", . . . ,","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0623","text":"for quality differences in services","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0624","text":".","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0625","text":"The main premise of this research is that quality differences in services are not accurately captured in the","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":["marker-family:loose_labelled","marker-signature:label:the","marker-depth:1","marker-is-path:false"],"attention":true},{"alias":"S0626","text":"current ICP methodology since it is very difficult to identify services of same quality in different countries","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0627","text":", .","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0628","text":"Although the ICP item structured product description (SPDs) detail a number of characteristics that must be observed there are certain aspects that are either subjective or difficult to quantify","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":2},"numbering":{},"markers":[],"attention":true},{"alias":"S0629","text":", .","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0630","text":"To address the issues the authors surveyed a group of people from the United States who had lived in Japan","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0631","text":",","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0632","text":"and a group of from Japan who had lived in the United States The survey questioned how much more or","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0633","text":". ,","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0634","text":"how much less the participants would pay for a service in their respective home countries if it were of a","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0635","text":", ,","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0636","text":"similar quality to those found in the country visited This allowed researchers to obtain a measure of the","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0637","text":".","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0638","text":"quality differences between each country for a variety of services based on their marginal willingness to pay","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0639","text":", .","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0640","text":"\u2019","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0641","text":"To account for the selection bias on utilizing a particular service the authors used the Heckman s selection","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0642","text":",","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0643","text":"model The results found the estimated effect of quality difference is about 9% between the two countries","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0644","text":". .","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0645","text":"The TAG discussed future research possibilities suggesting adding China as potential third country in service","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0646","text":",","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0647","text":"quality comparisons as well as refining the ICP SPDs by adding or improving the existing item specifications","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0648","text":", , .","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0649","text":"3 Treatment of Scanner (Transaction) Data in the European Comparison Programme (ECP)","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":true,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":["marker-family:arabic","marker-signature:Arabic:1","marker-depth:1","marker-is-path:true","marker-components:3"],"attention":true},{"alias":"S0650","text":".","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":true,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0651","text":"Mihai Iulian Gheorghe Eurostat presented the regional experience using scanner data in the European","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0652","text":", ,","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0653","text":"Comparison Programme (ECP)","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0654","text":".","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0655","text":"Scanner data is generated by point-of-sales terminals in shops and provides information at the level of the","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0656","text":"barcode or more correctly Global Trade Item Number (GTIN) Currently 18 countries are using scanner data","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0657","text":", , . ,","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0658","text":"9","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0659","text":"and four are testing their application The use of scanner data is regulated to ensure data transparency and","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0660","text":".","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0661","text":"allow for price validation","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0662","text":".","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0663","text":"The reporting of scanner data can be made in two ways: option A) Average price for each GTIN per shop chain","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0664","text":"per item (including weights within PPP item); option B: Weighted average price for each PPP item As for","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0665","text":".","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0666","text":"price weighting this can also be done by two methods: method 1) weights are available on GTIN level -","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0667","text":",","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0668","text":"dynamic weighting; method 2) weights are available on the level of the shop chain - fixed weighting The use","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0669","text":".","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0670","text":"of scanner data can also be accompanied by traditional price collection but at the item level it is preferred","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0671","text":",","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0672","text":"\u2019","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0673","text":"to choose either one source or another From Eurostat member countries experience the use of scanner","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0674","text":". ,","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0675","text":"data is more effective than traditional price collection at capturing discounted prices which results in lower","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0676","text":",","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0677","text":"prices for scanner data when compared to traditional price collection","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0678","text":".","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0679","text":"Considering the challenges and lessons learned it was noted that the use of transaction data initially does","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0680","text":",","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0681","text":"not necessarily lead to lower workload since different suppliers may have different data structures and it is","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0682","text":", ,","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0683","text":"necessary to identify and link GTINs to PPP survey items Additionally scanner data lacks details on item","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0684","text":". ,","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0685","text":"definitions and discounts and requires traditional price collection to continue in parallel","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0686","text":", .","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0687","text":"The TAG acknowledged these developments in price data collection recognizing the importance of","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0688","text":",","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"