"owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0697","text":"headings with negative expenditure within the PPP aggregation procedures","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0698","text":".","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0699","text":"The current ICP computation methodology assumes that price data contains only positive values while expenditure and quantity data contain only non-negative values (either positive or zero values) However","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":2},"numbering":{},"markers":[],"attention":true},{"alias":"S0700","text":". ,","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0701","text":"\u201C","owned":true,"scope":"quoted_replacement","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0702","text":"GDP expenditures contain several headings where negative expenditure can occur such as: Balance of","owned":true,"scope":"quoted_replacement","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0703","text":"\u201D \u201C \u201D \u201C \u201D \u201C","owned":true,"scope":"quoted_replacement","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0704","text":"Exports and Imports Change in inventories Net purchases abroad and Acquisitions less disposals of","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0705","text":", ,","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0706","text":"\u201D","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0707","text":"valuables While cases that affected computation were very limited in the previous ICP exercises this does","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0708","text":". ,","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0709","text":"not mean that negative expenditure values have no impact in the calculation of PPPs","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0710","text":".","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0711","text":"To mitigate the effects of negative headings two approaches were attempted in the past: i) use of selective","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":["marker-family:loose_labelled","marker-signature:label:to","marker-depth:1","marker-is-path:false"],"attention":true},{"alias":"S0712","text":",","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0713","text":"EKS procedure and ii) use of Tornqvist index for bilateral PPPs instead of Fisher PPPs However both methods","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0714","text":". ,","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0715","text":"are only applicable for the EKS aggregation method A possible procedure to overcome the issue would be","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0716","text":".","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0717","text":"to utilize absolute nominal values (for the PPP calculation only) instead of actual nominal values of","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0718","text":"expenditure data This approach is consistent with the theory of the calculation of average indices and is","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0719","text":".","owned":true,"scope":"table","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0720","text":"applicable not only for the EKS but for other aggregation methods as well","owned":true,"scope":"document_body","inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0721","text":".","owned":false},{"alias":"S0722","text":"The TAG noted that the use of absolute nominal values appears to be an improvised approach lacking a clear","owned":false},{"alias":"S0723","text":"\u201C \u201D","owned":false},{"alias":"S0724","text":"theoretical basis and the discussion focused on alternative treatments for net exports as it is the most","owned":false},{"alias":"S0725","text":", ,","owned":false},{"alias":"S0726","text":"affected category Nevertheless the case was also made that PPP calculations assume non-negative","owned":false},{"alias":"S0727","text":". ,","owned":false},{"alias":"S0728","text":"expenditures and hopefully distortions caused by negative expenditures are somewhat minimal It was","owned":false},{"alias":"S0729","text":".","owned":false},{"alias":"S0730","text":"suggested to continue research on this topic in the future","owned":false},{"alias":"S0731","text":".","owned":false},{"alias":"S0732","text":"5 Fine Tuning Global Linking Procedures","owned":false},{"alias":"S0733","text":".","owned":false},{"alias":"S0734","text":"Robert Hill University of Graz presented his research paper on Alternative Global Linking Methods","owned":false},{"alias":"S0735","text":", , .","owned":false},{"alias":"S0736","text":"The current methods for linking ICP regions at the global level are: i) Region-Product Dummy (RPD) at the","owned":false},{"alias":"S0737","text":"basic heading level and ii) Country Approach with Redistribution (CAR) at the aggregate level The paper","owned":false},{"alias":"S0738","text":".","owned":false},{"alias":"S0739","text":"proposes a third approach that would be applicable at both the basic heading and the aggregate levels and","owned":false},{"alias":"S0740","text":"\u201C \u201D","owned":false}]}
