},{"alias":"S0867","text":"a price shock always has a larger effect on Fisher compared to T\u00F6rnqvist indices","owned":true,"scope":"document_body","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0868","text":".","owned":true,"scope":"table","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0869","text":"For spatial analysis the ratio between Fisher and T\u00F6rnqvist indices is found to be even higher than temporal","owned":true,"scope":"document_body","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0870","text":",","owned":true,"scope":"table","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0871","text":"analysis In addition the GEKS and CCD PPP ratios were also compared for the ICP 2021 results and found","owned":true,"scope":"document_body","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0872","text":". ,","owned":true,"scope":"table","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S0873","text":"significant differences for some countries The paper suggest that the T\u00F6rnqvist-based CCD index is","owned":true,"scope":"document_body","tableDepth":0,"inTableOfContents":false,"style":{"Bold":false,"Italic":false,"RelativeFontSize":"body","LineCount":1},"numbering":{},"markers":[],"attention":true},{"alias":"S