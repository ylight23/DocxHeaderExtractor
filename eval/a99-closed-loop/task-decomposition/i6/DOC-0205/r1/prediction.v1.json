  "packetHash": "65b616df872739a49c9cba307f1530c6673e563bb014723ecabe395485a34afe",
  "passAHeadingCount": 71,
  "passBRoleCount": 71,
  "passAHeadings": [
    {
      "headingId": "H0001",
      "sourceId": "body[1]/p[4]",
      "start": 645,
      "end": 668,
      "text": "Ch\u01B0\u01A1ng I QUY \u0110\u1ECANH CHUNG"
    },
    {
      "headingId": "H0002",
      "sourceId": "body[1]/p[4]",
      "start": 669,
      "end": 695,
      "text": "\u0110i\u1EC1u 1. Ph\u1EA1m vi \u0111i\u1EC1u ch\u1EC9nh"
    },
    {
      "headingId": "H0003",
      "sourceId": "body[1]/p[4]",
      "start": 1337,
      "end": 1362,
      "text": "\u0110i\u1EC1u 2. \u0110\u1ED1i t\u01B0\u1EE3ng \u00E1p d\u1EE5ng"
    },
    {
      "headingId": "H0004",
      "sourceId": "body[1]/p[4]",
      "start": 1629,
      "end": 1654,
      "text": "\u0110i\u1EC1u 3. Gi\u1EA3i th\u00EDch t\u1EEB ng\u1EEF"
    },
    {
      "headingId": "H0005",
      "sourceId": "body[1]/p[4]",
      "start": 4361,
      "end": 4409,
      "text": "\u0110i\u1EC1u 4. Gi\u00E1 tr\u1ECB ph\u00E1p l\u00FD c\u1EE7a d\u1EEF li\u1EC7u \u0111\u01B0\u1EE3c chia s\u1EBB"
    },
    {
      "headingId": "H0006",
      "sourceId": "body[1]/p[4]",
      "start": 4626,
      "end": 4689,
      "text": "\u0110i\u1EC1u 5. Nguy\u00EAn t\u1EAFc chung v\u1EC1 qu\u1EA3n l\u00FD, k\u1EBFt n\u1ED1i v\u00E0 chia s\u1EBB d\u1EEF li\u1EC7u"
    },
    {
      "headingId": "H0007",
      "sourceId": "body[1]/p[4]",
      "start": 6603,
      "end": 6645,
      "text": "\u0110i\u1EC1u 6. Th\u1EF1c hi\u1EC7n k\u1EBFt n\u1ED1i, chia s\u1EBB d\u1EEF li\u1EC7u"
    },
    {
      "headingId": "H0008",
      "sourceId": "body[1]/p[4]",
      "start": 8146,
      "end": 8206,
      "text": "\u0110i\u1EC1u 7. Y\u00EAu c\u1EA7u trong vi\u1EC7c qu\u1EA3n l\u00FD, k\u1EBFt n\u1ED1i, chia s\u1EBB d\u1EEF li\u1EC7u"
    },
    {
      "headingId": "H0009",
      "sourceId": "body[1]/p[4]",
      "start": 9298,
      "end": 9332,
      "text": "\u0110i\u1EC1u 8. C\u00E1c h\u00E0nh vi kh\u00F4ng \u0111\u01B0\u1EE3c l\u00E0m"
    },
    {
      "headingId": "H0010",
      "sourceId": "body[1]/p[4]",
      "start": 9843,
      "end": 9978,
      "text": "Ch\u01B0\u01A1ng II QU\u1EA2N L\u00DD D\u1EEE LI\u1EC6U, C\u01A0 S\u1EDE D\u1EEE LI\u1EC6U, QU\u1EA2N TR\u1ECA D\u1EEE LI\u1EC6U TRONG C\u01A0 QUAN NH\u00C0 N\u01AF\u1EDAC V\u00C0 B\u1EA2O \u0110\u1EA2M KH\u1EA2 N\u0102NG S\u1EB4N S\u00C0NG K\u1EBET N\u1ED0I, CHIA S\u1EBA D\u1EEE LI\u1EC6U"
    },
    {
      "headingId": "H0011",
      "sourceId": "body[1]/p[4]",
      "start": 9979,
      "end": 10039,
      "text": "M\u1EE5c 1. QU\u1EA2N L\u00DD D\u1EEE LI\u1EC6U, C\u01A0 S\u1EDE D\u1EEE LI\u1EC6U TRONG C\u01A0 QUAN NH\u00C0 N\u01AF\u1EDAC"
    },
    {
      "headingId": "H0012",
      "sourceId": "body[1]/p[4]",
      "start": 10040,
      "end": 10112,
      "text": "\u0110i\u1EC1u 9. Nguy\u00EAn t\u1EAFc qu\u1EA3n l\u00FD d\u1EEF li\u1EC7u, c\u01A1 s\u1EDF d\u1EEF li\u1EC7u trong c\u01A1 quan nh\u00E0 n\u01B0\u1EDBc"
    },
    {
      "headingId": "H0013",
      "sourceId": "body[1]/p[4]",
      "start": 10904,
      "end": 10952,
      "text": "\u0110i\u1EC1u 10. T\u1ED5 ch\u1EE9c, qu\u1EA3n l\u00FD d\u1EEF li\u1EC7u, c\u01A1 s\u1EDF d\u1EEF li\u1EC7u"
    },
    {
      "headingId": "H0014",
      "sourceId": "body[1]/p[4]",
      "start": 11449,
      "end": 11494,
      "text": "\u0110i\u1EC1u 11. C\u01A1 s\u1EDF d\u1EEF li\u1EC7u trong c\u01A1 quan nh\u00E0 n\u01B0\u1EDBc"
    },
    {
      "headingId": "H0015",
      "sourceId": "body[1]/p[4]",
      "start": 13065,
      "end": 13146,
      "text": "\u0110i\u1EC1u 12. Danh m\u1EE5c c\u01A1 s\u1EDF d\u1EEF li\u1EC7u qu\u1ED1c gia, duy tr\u00EC danh m\u1EE5c c\u01A1 s\u1EDF d\u1EEF li\u1EC7u qu\u1ED1c gia"
    },
    {
      "headingId": "H0016",
      "sourceId": "body[1]/p[4]",
      "start": 14829,
      "end": 14859,
      "text": "\u0110i\u1EC1u 13. C\u1ED5ng d\u1EEF li\u1EC7u qu\u1ED1c gia"
    },
    {
      "headingId": "H0017",
      "sourceId": "body[1]/p[4]",
      "start": 15558,
      "end": 15618,
      "text": "M\u1EE5c 2. QU\u1EA2N TR\u1ECA D\u1EEE LI\u1EC6U, QU\u1EA2N TR\u1ECA CHIA S\u1EBA, KHAI TH\u00C1C D\u1EEE LI\u1EC6U"
    },
    {
      "headingId": "H0018",
      "sourceId": "body[1]/p[4]",
      "start": 15619,
      "end": 15691,
      "text": "\u0110i\u1EC1u 14. Ho\u1EA1t \u0111\u1ED9ng qu\u1EA3n tr\u1ECB d\u1EEF li\u1EC7u, qu\u1EA3n tr\u1ECB chia s\u1EBB, khai th\u00E1c d\u1EEF li\u1EC7u"
    },
    {
      "headingId": "H0019",
      "sourceId": "body[1]/p[4]",
      "start": 16890,
      "end": 16963,
      "text": "\u0110i\u1EC1u 15. Thanh tra, ki\u1EC3m tra, gi\u00E1m s\u00E1t qu\u00E1 tr\u00ECnh k\u1EBFt n\u1ED1i, chia s\u1EBB d\u1EEF li\u1EC7u"
    },
    {
      "headingId": "H0020",
      "sourceId": "body[1]/p[4]",
      "start": 17527,
      "end": 17571,
      "text": "\u0110i\u1EC1u 16. Ki\u1EC3m tra, \u0111\u00E1nh gi\u00E1, duy tr\u00EC d\u1EEF li\u1EC7u"
    },
    {
      "headingId": "H0021",
      "sourceId": "body[1]/p[4]",
      "start": 19329,
      "end": 19367,
      "text": "M\u1EE5c 3. D\u1EEE LI\u1EC6U M\u1EDE C\u1EE6A C\u01A0 QUAN NH\u00C0 N\u01AF\u1EDAC"
    },
    {
      "headingId": "H0022",
      "sourceId": "body[1]/p[4]",
      "start": 19368,
      "end": 19428,
      "text": "\u0110i\u1EC1u 17. Nguy\u00EAn t\u1EAFc cung c\u1EA5p d\u1EEF li\u1EC7u m\u1EDF c\u1EE7a c\u01A1 quan nh\u00E0 n\u01B0\u1EDBc"
    },
    {
      "headingId": "H0023",
      "sourceId": "body[1]/p[4]",
      "start": 20463,
      "end": 20520,
      "text": "\u0110i\u1EC1u 18. Quy \u0111\u1ECBnh s\u1EED d\u1EE5ng d\u1EEF li\u1EC7u m\u1EDF c\u1EE7a c\u01A1 quan nh\u00E0 n\u01B0\u1EDBc"
    },
    {
      "headingId": "H0024",
      "sourceId": "body[1]/p[4]",
      "start": 21486,
      "end": 21553,
      "text": "\u0110i\u1EC1u 19. K\u1EBF ho\u1EA1ch v\u00E0 tri\u1EC3n khai d\u1EEF li\u1EC7u m\u1EDF c\u1EE7a c\u00E1c c\u01A1 quan nh\u00E0 n\u01B0\u1EDBc"
    },
    {
      "headingId": "H0025",
      "sourceId": "body[1]/p[4]",
      "start": 22765,
      "end": 22832,
      "text": "\u0110i\u1EC1u 20. Y\u00EAu c\u1EA7u trong vi\u1EC7c c\u00F4ng b\u1ED1 d\u1EEF li\u1EC7u m\u1EDF c\u1EE7a c\u01A1 quan nh\u00E0 n\u01B0\u1EDBc"
    },
    {
      "headingId": "H0026",
      "sourceId": "body[1]/p[4]",
      "start": 23401,
      "end": 23472,
      "text": "\u0110i\u1EC1u 21. Ph\u01B0\u01A1ng th\u1EE9c, c\u00E1ch th\u1EE9c c\u00F4ng b\u1ED1 d\u1EEF li\u1EC7u m\u1EDF c\u1EE7a c\u01A1 quan nh\u00E0 n\u01B0\u1EDBc"
    },
    {
      "headingId": "H0027",
      "sourceId": "body[1]/p[4]",
      "start": 23745,
      "end": 23802,
      "text": "M\u1EE5c 4. B\u1EA2O \u0110\u1EA2M KH\u1EA2 N\u0102NG S\u1EB4N S\u00C0NG K\u1EBET N\u1ED0I, CHIA S\u1EBA D\u1EEE LI\u1EC6U"
    },
    {
      "headingId": "H0028",
      "sourceId": "body[1]/p[4]",
      "start": 23803,
      "end": 23854,
      "text": "\u0110i\u1EC1u 22. Quy ch\u1EBF khai th\u00E1c, s\u1EED d\u1EE5ng d\u1EEF li\u1EC7u chia s\u1EBB"
    },
    {
      "headingId": "H0029",
      "sourceId": "body[1]/p[4]",
      "start": 24158,
      "end": 24194,
      "text": "\u0110i\u1EC1u 23. Ph\u01B0\u01A1ng th\u1EE9c chia s\u1EBB d\u1EEF li\u1EC7u"
    },
    {
      "headingId": "H0030",
      "sourceId": "body[1]/p[4]",
      "start": 25199,
      "end": 25231,
      "text": "\u0110i\u1EC1u 24. D\u1ECBch v\u1EE5 chia s\u1EBB d\u1EEF li\u1EC7u"
    },
    {
      "headingId": "H0031",
      "sourceId": "body[1]/p[4]",
      "start": 26019,
      "end": 26074,
      "text": "\u0110i\u1EC1u 25. C\u00F4ng khai th\u00F4ng tin v\u1EC1 d\u1ECBch v\u1EE5 chia s\u1EBB d\u1EEF li\u1EC7u"
    },
    {
      "headingId": "H0032",
      "sourceId": "body[1]/p[4]",
      "start": 27351,
      "end": 27400,
      "text": "\u0110i\u1EC1u 26. H\u1EC7 th\u1ED1ng qu\u1EA3n l\u00FD d\u1ECBch v\u1EE5 chia s\u1EBB d\u1EEF li\u1EC7u"
    },
    {
      "headingId": "H0033",
      "sourceId": "body[1]/p[4]",
      "start": 28415,
      "end": 28456,
      "text": "\u0110i\u1EC1u 27. H\u1EA1 t\u1EA7ng k\u1EBFt n\u1ED1i, chia s\u1EBB d\u1EEF li\u1EC7u"
    },
    {
      "headingId": "H0034",
      "sourceId": "body[1]/p[4]",
      "start": 29974,
      "end": 30039,
      "text": "\u0110i\u1EC1u 28. B\u1EA3o \u0111\u1EA3m an to\u00E0n trong qu\u00E1 tr\u00ECnh k\u1EBFt n\u1ED1i, chia s\u1EBB d\u1EEF li\u1EC7u"
    },
    {
      "headingId": "H0035",
      "sourceId": "body[1]/p[4]",
      "start": 30572,
      "end": 30622,
      "text": "\u0110i\u1EC1u 29. Kinh ph\u00ED b\u1EA3o \u0111\u1EA3m k\u1EBFt n\u1ED1i, chia s\u1EBB d\u1EEF li\u1EC7u"
    },
    {
      "headingId": "H0036",
      "sourceId": "body[1]/p[4]",
      "start": 32357,
      "end": 32413,
      "text": "\u0110i\u1EC1u 30. Ngu\u1ED3n nh\u00E2n l\u1EF1c b\u1EA3o \u0111\u1EA3m k\u1EBFt n\u1ED1i, chia s\u1EBB d\u1EEF li\u1EC7u"
    },
    {
      "headingId": "H0037",
      "sourceId": "body[1]/p[4]",
      "start": 32768,
      "end": 32822,
      "text": "Ch\u01B0\u01A1ng III TH\u1EF0C HI\u1EC6N K\u1EBET N\u1ED0I, CHIA S\u1EBA, S\u1EEC D\u1EE4NG D\u1EEE LI\u1EC6U"
    },
    {
      "headingId": "H0038",
      "sourceId": "body[1]/p[4]",
      "start": 32823,
      "end": 32862,
      "text": "M\u1EE5c 1. T\u1ED4 CH\u1EE8C K\u1EBET N\u1ED0I, CHIA S\u1EBA D\u1EEE LI\u1EC6U"
    },
    {
      "headingId": "H0039",
      "sourceId": "body[1]/p[4]",
      "start": 32863,
      "end": 32994,
      "text": "\u0110i\u1EC1u 31. K\u1EBFt n\u1ED1i, chia s\u1EBB d\u1EEF li\u1EC7u gi\u1EEFa c\u00E1c b\u1ED9, c\u01A1 quan ngang b\u1ED9, c\u01A1 quan thu\u1ED9c Ch\u00EDnh ph\u1EE7, c\u00E1c t\u1EC9nh, th\u00E0nh ph\u1ED1 tr\u1EF1c thu\u1ED9c trung \u01B0\u01A1ng"
    },
    {
      "headingId": "H0040",
      "sourceId": "body[1]/p[4]",
      "start": 34108,
      "end": 34247,
      "text": "\u0110i\u1EC1u 32. K\u1EBFt n\u1ED1i, chia s\u1EBB d\u1EEF li\u1EC7u trong n\u1ED9i b\u1ED9 c\u1EE7a b\u1ED9, c\u01A1 quan ngang b\u1ED9, c\u01A1 quan thu\u1ED9c Ch\u00EDnh ph\u1EE7, c\u00E1c t\u1EC9nh, th\u00E0nh ph\u1ED1 tr\u1EF1c thu\u1ED9c trung \u01B0\u01A1ng"
    },
    {
      "headingId": "H0041",
      "sourceId": "body[1]/p[4]",
      "start": 35467,
      "end": 35498,
      "text": "M\u1EE5c 2. CHIA S\u1EBA D\u1EEE LI\u1EC6U M\u1EB6C \u0110\u1ECANH"
    },
    {
      "headingId": "H0042",
      "sourceId": "body[1]/p[4]",
      "start": 35499,
      "end": 35546,
      "text": "\u0110i\u1EC1u 33. Chu\u1EA9n b\u1ECB v\u00E0 th\u1EF1c hi\u1EC7n cung c\u1EA5p d\u1EEF li\u1EC7u"
    },
    {
      "headingId": "H0043",
      "sourceId": "body[1]/p[4]",
      "start": 36126,
      "end": 36182,
      "text": "\u0110i\u1EC1u 34. D\u1EEF li\u1EC7u chia s\u1EBB theo h\u00ECnh th\u1EE9c chia s\u1EBB m\u1EB7c \u0111\u1ECBnh"
    },
    {
      "headingId": "H0044",
      "sourceId": "body[1]/p[4]",
      "start": 36916,
      "end": 36963,
      "text": "\u0110i\u1EC1u 35. G\u1EEDi y\u00EAu c\u1EA7u k\u1EBFt n\u1ED1i, khai th\u00E1c d\u1EEF li\u1EC7u"
    },
    {
      "headingId": "H0045",
      "sourceId": "body[1]/p[4]",
      "start": 37929,
      "end": 37972,
      "text": "M\u1EE5c 3. CHIA S\u1EBA D\u1EEE LI\u1EC6U THEO Y\u00CAU C\u1EA6U \u0110\u1EB6C TH\u00D9"
    },
    {
      "headingId": "H0046",
      "sourceId": "body[1]/p[4]",
      "start": 37973,
      "end": 38029,
      "text": "\u0110i\u1EC1u 36. Nguy\u00EAn t\u1EAFc chia s\u1EBB d\u1EEF li\u1EC7u theo y\u00EAu c\u1EA7u \u0111\u1EB7c th\u00F9"
    },
    {
      "headingId": "H0047",
      "sourceId": "body[1]/p[4]",
      "start": 38781,
      "end": 38832,
      "text": "\u0110i\u1EC1u 37. Tr\u00ECnh t\u1EF1 chu\u1EA9n b\u1ECB k\u1EBFt n\u1ED1i, chia s\u1EBB d\u1EEF li\u1EC7u"
    },
    {
      "headingId": "H0048",
      "sourceId": "body[1]/p[4]",
      "start": 39241,
      "end": 39285,
      "text": "\u0110i\u1EC1u 38. N\u1ED9i dung th\u1ED1ng nh\u1EA5t chia s\u1EBB d\u1EEF li\u1EC7u"
    },
    {
      "headingId": "H0049",
      "sourceId": "body[1]/p[4]",
      "start": 40307,
      "end": 40359,
      "text": "\u0110i\u1EC1u 39. Th\u1EF1c hi\u1EC7n k\u1EBFt n\u1ED1i, chia s\u1EBB, s\u1EED d\u1EE5ng d\u1EEF li\u1EC7u"
    },
    {
      "headingId": "H0050",
      "sourceId": "body[1]/p[4]",
      "start": 40706,
      "end": 40745,
      "text": "M\u1EE5c 4. QU\u1EA2N L\u00DD K\u1EBET N\u1ED0I, CHIA S\u1EBA D\u1EEE LI\u1EC6U"
    },
    {
      "headingId": "H0051",
      "sourceId": "body[1]/p[4]",
      "start": 40746,
      "end": 40793,
      "text": "\u0110i\u1EC1u 40. T\u00E0i kho\u1EA3n v\u00E0 qu\u1EA3n l\u00FD t\u00E0i kho\u1EA3n k\u1EBFt n\u1ED1i"
    },
    {
      "headingId": "H0052",
      "sourceId": "body[1]/p[4]",
      "start": 41526,
      "end": 41577,
      "text": "\u0110i\u1EC1u 41. Th\u1EDDi h\u1EA1n s\u1EED d\u1EE5ng d\u1EEF li\u1EC7u sau khi khai th\u00E1c"
    },
    {
      "headingId": "H0053",
      "sourceId": "body[1]/p[4]",
      "start": 42645,
      "end": 42692,
      "text": "\u0110i\u1EC1u 42. L\u01B0u tr\u1EEF d\u1EEF li\u1EC7u khi k\u1EBFt n\u1ED1i, khai th\u00E1c"
    },
    {
      "headingId": "H0054",
      "sourceId": "body[1]/p[4]",
      "start": 42984,
      "end": 43069,
      "text": "\u0110i\u1EC1u 43. T\u1EA1m ng\u1EEBng k\u1EBFt n\u1ED1i, cung c\u1EA5p d\u1EEF li\u1EC7u tr\u00EAn m\u00F4i tr\u01B0\u1EDDng m\u1EA1ng do c\u01A1 quan cung c\u1EA5p"
    },
    {
      "headingId": "H0055",
      "sourceId": "body[1]/p[4]",
      "start": 44921,
      "end": 44983,
      "text": "\u0110i\u1EC1u 44. Ch\u1EA5m d\u1EE9t k\u1EBFt n\u1ED1i, chia s\u1EBB d\u1EEF li\u1EC7u qua m\u00F4i tr\u01B0\u1EDDng m\u1EA1ng"
    },
    {
      "headingId": "H0056",
      "sourceId": "body[1]/p[4]",
      "start": 45915,
      "end": 45955,
      "text": "\u0110i\u1EC1u 45. L\u01B0u tr\u1EEF nh\u1EADt k\u00FD chia s\u1EBB d\u1EEF li\u1EC7u"
    },
    {
      "headingId": "H0057",
      "sourceId": "body[1]/p[4]",
      "start": 46641,
      "end": 46682,
      "text": "\u0110i\u1EC1u 46. M\u00F4 h\u00ECnh k\u1EBFt n\u1ED1i, chia s\u1EBB d\u1EEF li\u1EC7u"
    },
    {
      "headingId": "H0058",
      "sourceId": "body[1]/p[4]",
      "start": 47323,
      "end": 47375,
      "text": "M\u1EE5c 5. GI\u1EA2I QUY\u1EBET V\u01AF\u1EDANG M\u1EAEC K\u1EBET N\u1ED0I, CHIA S\u1EBA D\u1EEE LI\u1EC6U"
    },
    {
      "headingId": "H0059",
      "sourceId": "body[1]/p[4]",
      "start": 47376,
      "end": 47436,
      "text": "\u0110i\u1EC1u 47. V\u01B0\u1EDBng m\u1EAFc khi k\u1EBFt n\u1ED1i, chia s\u1EBB v\u00E0 khai th\u00E1c d\u1EEF li\u1EC7u"
    },
    {
      "headingId": "H0060",
      "sourceId": "body[1]/p[4]",
      "start": 47923,
      "end": 47974,
      "text": "\u0110i\u1EC1u 48. Th\u1EA9m quy\u1EC1n ti\u1EBFp nh\u1EADn, gi\u1EA3i quy\u1EBFt v\u01B0\u1EDBng m\u1EAFc"
    },
    {
      "headingId": "H0061",
      "sourceId": "body[1]/p[4]",
      "start": 48627,
      "end": 48660,
      "text": "\u0110i\u1EC1u 49. Tr\u00ECnh t\u1EF1 x\u1EED l\u00FD v\u01B0\u1EDBng m\u1EAFc"
    },
    {
      "headingId": "H0062",
      "sourceId": "body[1]/p[4]",
      "start": 50264,
      "end": 50342,
      "text": "\u0110i\u1EC1u 50. Ph\u01B0\u01A1ng \u00E1n gi\u1EA3i quy\u1EBFt v\u00E0 tri\u1EC3n khai tu\u00E2n th\u1EE7 ph\u01B0\u01A1ng \u00E1n x\u1EED l\u00FD v\u01B0\u1EDBng m\u1EAFc"
    },
    {
      "headingId": "H0063",
      "sourceId": "body[1]/p[4]",
      "start": 50896,
      "end": 50955,
      "text": "Ch\u01B0\u01A1ng IV QUY\u1EC0N, TR\u00C1CH NHI\u1EC6M TRONG K\u1EBET N\u1ED0I, CHIA S\u1EBA D\u1EEE LI\u1EC6U"
    },
    {
      "headingId": "H0064",
      "sourceId": "body[1]/p[4]",
      "start": 50956,
      "end": 51014,
      "text": "\u0110i\u1EC1u 51. Quy\u1EC1n v\u00E0 tr\u00E1ch nhi\u1EC7m c\u1EE7a c\u01A1 quan cung c\u1EA5p d\u1EEF li\u1EC7u"
    },
    {
      "headingId": "H0065",
      "sourceId": "body[1]/p[4]",
      "start": 52830,
      "end": 52907,
      "text": "\u0110i\u1EC1u 52. Quy\u1EC1n v\u00E0 tr\u00E1ch nhi\u1EC7m c\u1EE7a t\u1ED5 ch\u1EE9c, c\u00E1 nh\u00E2n khai th\u00E1c, s\u1EED d\u1EE5ng d\u1EEF li\u1EC7u"
    },
    {
      "headingId": "H0066",
      "sourceId": "body[1]/p[4]",
      "start": 53712,
      "end": 53786,
      "text": "\u0110i\u1EC1u 53. Tr\u00E1ch nhi\u1EC7m c\u1EE7a c\u00E1c b\u1ED9, c\u01A1 quan ngang b\u1ED9, c\u01A1 quan thu\u1ED9c Ch\u00EDnh ph\u1EE7"
    },
    {
      "headingId": "H0067",
      "sourceId": "body[1]/p[4]",
      "start": 56513,
      "end": 56595,
      "text": "\u0110i\u1EC1u 54. Tr\u00E1ch nhi\u1EC7m c\u1EE7a \u1EE6y ban nh\u00E2n d\u00E2n c\u00E1c t\u1EC9nh, th\u00E0nh ph\u1ED1 tr\u1EF1c thu\u1ED9c trung \u01B0\u01A1ng"
    },
    {
      "headingId": "H0068",
      "sourceId": "body[1]/p[4]",
      "start": 57453,
      "end": 57481,
      "text": "Ch\u01B0\u01A1ng V \u0110I\u1EC0U KHO\u1EA2N THI H\u00C0NH"
    },
    {
      "headingId": "H0069",
      "sourceId": "body[1]/p[4]",
      "start": 57482,
      "end": 57513,
      "text": "\u0110i\u1EC1u 55. \u0110i\u1EC1u kho\u1EA3n chuy\u1EC3n ti\u1EBFp"
    },
    {
      "headingId": "H0070",
      "sourceId": "body[1]/p[4]",
      "start": 58966,
      "end": 58992,
      "text": "\u0110i\u1EC1u 56. Hi\u1EC7u l\u1EF1c thi h\u00E0nh"
    },
    {
      "headingId": "H0071",
      "sourceId": "body[1]/p[4]",
      "start": 59240,
      "end": 59269,
      "text": "\u0110i\u1EC1u 57. Tr\u00E1ch nhi\u1EC7m thi h\u00E0nh"
    }
  ],
