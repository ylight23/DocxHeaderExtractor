    {
      "sourceParts": [
        {
          "sourceAlias": "L0009:S0",
          "verbatimText": "Abstract"
        }
      ],
      "semanticFunction": "REGION_STRUCTURE"
    },
    {
      "sourceParts": [
        {
          "sourceAlias": "L0010:S0",
          "verbatimText": "The QUIC transport protocol has several features that are desirable in a transport for HTTP, such"
        },
        {
          "sourceAlias": "L0011:S0",
          "verbatimText": "as stream multiplexing, per-stream \uFB02ow control, and low-latency connection establishment. This"
        },
        {
          "sourceAlias": "L0012:S0",
          "verbatimText": "document describes a mapping ofHTTP semantics over QUIC. This document also identi\uFB01es"
        },
        {
          "sourceAlias": "L0013:S0",
          "verbatimText": "HTTP/2 features that are subsumed by QUIC and describes how HTTP/2 extensions can be ported"
        },
        {
          "sourceAlias": "L0014:S0",
          "verbatimText": "to HTTP/3."
        }
      ],
      "semanticFunction": "BODY_INFORMATION"
    },
    {
      "sourceParts": [
        {
          "sourceAlias": "L0015:S0",
          "verbatimText": "Status ofThis Memo"
        }
      ],
      "semanticFunction": "REGION_STRUCTURE"
    },
    {
      "sourceParts": [
        {
          "sourceAlias": "L0016:S0",
          "verbatimText": "This is an Internet Standards Track document."
        },
        {
          "sourceAlias": "L0017:S0",
          "verbatimText": "This document is a product ofthe Internet Engineering Task Force (IETF). It represents the"
        },
        {
          "sourceAlias": "L0018:S0",
          "verbatimText": "consensus ofthe IETF community. It has received public review and has been approved for"
        },
        {
          "sourceAlias": "L0019:S0",
          "verbatimText": "publication by the Internet Engineering Steering Group (IESG). Further information on Internet"
        },
        {
          "sourceAlias": "L0020:S0",
          "verbatimText": "Standards is available in Section 2 ofRFC 7841."
        },
        {
          "sourceAlias": "L0021:S0",
          "verbatimText": "Information about the current status ofthis document, any errata, and how to provide feedback"
        },
        {
          "sourceAlias": "L0022:S0",
          "verbatimText": "on it may be obtained at https://www.rfc-editor.org/info/rfc9114."
        }
      ],
      "semanticFunction": "BODY_INFORMATION"
    },
