      "occurrenceRoles": [
        "FIELD_LABEL"
      ],
      "titleRelation": "NONE",
      "repeatStatus": "FIRST",
      "isHeading": false
    },
    {
      "text": "Table A. Local Currency",
      "semanticFunctions": [
        "IDENTITY"
      ],
      "scope": "TABLE",
      "occurrenceRoles": [
        "CAPTION"
      ],
      "titleRelation": "TITLE",
      "repeatStatus": "FIRST",
      "isHeading": false
    },
    {
      "text": "Part C – Fraud and Corruption",
      "semanticFunctions": [
