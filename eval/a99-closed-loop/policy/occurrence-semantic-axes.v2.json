      ],
      "titleRelation": "TITLE_PART",
      "repeatStatus": "FIRST",
      "isHeading": true
    }
  ],
  "legacyProjection": {
    "mapping": {
      "IDENTITY": "DOCUMENT_LABEL",
      "STRUCTURE": "STRUCTURAL_UNIT",
      "INFORMATION": "NON_STRUCTURAL"
    },
    "lossy": true,
    "lostDistinctions": [
      "INFORMATION + REGION_OPENER",
      "IDENTITY + STRUCTURE",
      "IDENTITY + CAPTION",
      "REPEATED + REGION_OPENER"
    ]
  },
  "modelContractChanged": false
