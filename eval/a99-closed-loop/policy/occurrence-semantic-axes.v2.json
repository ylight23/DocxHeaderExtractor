        "STRUCTURE"
      ],
      "scope": "DOCUMENT_PART",
      "occurrenceRoles": [
        "REGION_OPENER"
      ],
      "titleRelation": "TITLE",
      "repeatStatus": "FIRST",
      "isHeading": true
    },
    {
      "text": "Particular Conditions (again, above Part C)",
      "semanticFunctions": [
        "IDENTITY"
      ],
      "scope": "DOCUMENT",
      "occurrenceRoles": [
        "REGION_OPENER"
      ],
      "titleRelation": "TITLE",
      "repeatStatus": "REPEATED",
      "isHeading": true
    },
    {
      "text": "ES Demand Guarantee (under its form title)",
      "semanticFunctions": [
