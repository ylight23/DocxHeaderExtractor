{
  "artifactKind": "a99_human_gold_schema",
  "schemaVersion": "a99-human-gold-v3",
  "authorityClass": "HUMAN_GOLD",
  "positiveSetOnly": true,
  "reviewedEntireDocument": true,
  "headingSetExhaustive": true,
  "authorityFields": [
    "goldStatus",
    "finalAuthority",
    "referenceProvenance",
    "userFinalApproval",
    "reviewedEntireDocument",
    "headingSetExhaustive",
    "unresolvedSemanticUncertainty"
  ],
  "independentOfModelPrediction": "truthful provenance metadata; not an eligibility requirement",
  "strictGoldEligibility": "goldStatus=STRICT_GOLD and finalAuthority=USER and userFinalApproval=true and reviewedEntireDocument=true and headingSetExhaustive=true and unresolvedSemanticUncertainty=false",
  "evaluationCapabilities": ["semanticEvaluable", "occurrenceEvaluable", "characterSpanEvaluable", "roleEvaluable", "levelEvaluable", "parentEvaluable", "hierarchyEvaluable"],
  "requiredHeadingFields": [
    "headingOccurrenceId",
    "sourceId",
    "stableId",
    "sourceOrdinal",
    "sourceSpan",
    "sourceTextHash",
    "headingSpan",
    "role",
    "level",
    "parentHeadingOccurrenceId"
  ],
  "headingOccurrenceIdentity": "sourceId + exact headingSpan.start + exact headingSpan.end; document id and source SHA scope the packet",
  "physicalSourceOccurrenceIdentity": "documentId + sourceId",
  "rootParentSentinel": "ROOT",
  "unsureSpans": {
    "field": "unsureSpans",
    "items": ["sourceId", "span", "reason"],
    "blocksHeadingSetExhaustive": true
  },
  "forbiddenHeadingParentFields": ["ParentSourceId", "parentSourceId", "parentOccurrenceId"],
  "forbidden": ["prediction", "candidate", "confidence", "validatorOutput", "decision", "filenameIdentity", "fuzzyIdentity"]
}
