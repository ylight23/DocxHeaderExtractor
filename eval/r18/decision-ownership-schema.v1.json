{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ylight23.github.io/DocxHeaderExtractor/eval/r18/decision-ownership-schema.v1.json",
  "title": "R18 decision ownership report",
  "type": "object",
  "required": [
    "artifactKind",
    "schemaVersion",
    "documentId",
    "sourceKind",
    "observations",
    "disagreementMetrics",
    "firstLossSummary",
    "deterministicDiagnostics",
    "providerCalls",
    "referenceBackedObservationCount",
    "direction",
    "accuracyClaim"
  ],
  "properties": {
    "artifactKind": { "const": "r18_decision_ownership_report" },
    "schemaVersion": { "const": "r18-decision-ownership-v1" },
    "documentId": { "type": "string", "minLength": 1 },
    "sourceKind": { "type": "string", "minLength": 1 },
    "observations": { "type": "array", "items": { "type": "object" } },
    "disagreementMetrics": { "type": "object" },
    "firstLossSummary": { "type": "object" },
    "deterministicDiagnostics": { "type": "object" },
    "providerCalls": { "type": "integer", "minimum": 0 },
    "referenceBackedObservationCount": { "type": "integer", "minimum": 0 },
    "direction": { "type": "string" },
    "accuracyClaim": { "const": "NOT_MEASURED" }
  }
}
