<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>dhx</AssemblyName>
    <RootNamespace>DocxHeaderExtractor.Cli</RootNamespace>
    <!-- Cần ICU đầy đủ để so sánh chuỗi tiếng Việt không phân biệt hoa thường/dấu -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocxHeaderExtractor.Core\DocxHeaderExtractor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Backend llama.cpp. Mặc định CPU (AVX/AVX2/AVX512, tự chọn theo CPU).
      Build với -p:UseCuda=true để dùng CUDA 12 — chỉ có ích khi máy có GPU NVIDIA;
      gói CUDA nặng ~700 MB nên không đặt mặc định.
    -->
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" Condition="'$(UseCuda)' != 'true'" />
    <PackageReference Include="LLamaSharp.Backend.Cuda12" Version="0.27.0" Condition="'$(UseCuda)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
