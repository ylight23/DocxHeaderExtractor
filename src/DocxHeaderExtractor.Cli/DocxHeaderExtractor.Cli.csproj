<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>dhx</AssemblyName>
    <RootNamespace>DocxHeaderExtractor.Cli</RootNamespace>
    <!-- Cần ICU đầy đủ để so sánh chuỗi tiếng Việt không phân biệt hoa thường/dấu -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocxHeaderExtractor.App\DocxHeaderExtractor.App.csproj" />
    <ProjectReference Include="..\DocxHeaderExtractor.Sources\DocxHeaderExtractor.Sources.csproj" />
    <ProjectReference Include="..\DocxHeaderExtractor.DocumentProcessing\DocxHeaderExtractor.DocumentProcessing.csproj" />
  </ItemGroup>

</Project>
