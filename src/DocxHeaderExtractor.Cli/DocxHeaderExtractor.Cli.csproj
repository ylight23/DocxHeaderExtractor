<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>dhx</AssemblyName>
    <RootNamespace>DocxHeaderExtractor.Cli</RootNamespace>
    <!-- Cần ICU đầy đủ để so sánh chuỗi tiếng Việt không phân biệt hoa thường/dấu -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocxHeaderExtractor.AgentHarness\DocxHeaderExtractor.AgentHarness.csproj" />
    <ProjectReference Include="..\DocxHeaderExtractor.Core\DocxHeaderExtractor.Core.csproj" />
    <ProjectReference Include="..\DocxHeaderExtractor.Infrastructure\DocxHeaderExtractor.Infrastructure.csproj" />
    <ProjectReference Include="..\DocxHeaderExtractor.Eval\DocxHeaderExtractor.Eval.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Backend llama.cpp. Mặc định CPU (AVX/AVX2/AVX512, tự chọn theo CPU).
      Build với -p:UseCuda=true để dùng CUDA 12 — chỉ có ích khi máy có GPU NVIDIA;
      gói CUDA nặng ~700 MB nên không đặt mặc định.
      Build với -p:UseVulkan=true cho GPU AMD/Intel (và cả NVIDIA) — máy cần sẵn
      vulkan-1.dll của driver. Chỉ đặt MỘT trong hai cờ: bật cả hai thì cả hai gói
      cùng đổ native lib vào runtimes/ và LLamaSharp sẽ chọn theo thứ tự riêng của nó.
    -->
    <PackageReference Include="LLamaSharp.Backend.Cpu" Condition="'$(UseCuda)' != 'true' AND '$(UseVulkan)' != 'true'" />
    <PackageReference Include="LLamaSharp.Backend.Cuda12" Condition="'$(UseCuda)' == 'true'" />
    <PackageReference Include="LLamaSharp.Backend.Vulkan" Condition="'$(UseVulkan)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
