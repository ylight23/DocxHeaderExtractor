<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>dhx</AssemblyName>
    <RootNamespace>DocxHeaderExtractor.Cli</RootNamespace>
    <!-- Cần ICU đầy đủ để so sánh chuỗi tiếng Việt không phân biệt hoa thường/dấu -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocxHeaderExtractor.Core\DocxHeaderExtractor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Backend CPU của llama.cpp: đi kèm native lib AVX/AVX2/AVX512, tự chọn theo CPU -->
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
