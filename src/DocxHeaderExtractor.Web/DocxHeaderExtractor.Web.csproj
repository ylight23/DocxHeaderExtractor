<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>dhx-ui</AssemblyName>
    <RootNamespace>DocxHeaderExtractor.Web</RootNamespace>
    <!-- Cần ICU đầy đủ để so sánh chuỗi tiếng Việt không phân biệt hoa thường/dấu -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocxHeaderExtractor.Core\DocxHeaderExtractor.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Xem ghi chú ở DocxHeaderExtractor.Cli.csproj: -p:UseCuda=true để đổi sang CUDA 12 -->
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.27.0" Condition="'$(UseCuda)' != 'true'" />
    <PackageReference Include="LLamaSharp.Backend.Cuda12" Version="0.27.0" Condition="'$(UseCuda)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Web SDK chỉ chép wwwroot khi publish; ta chạy thẳng dll trong bin nên cần chép khi build -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
