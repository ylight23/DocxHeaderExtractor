<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>dhx-ui</AssemblyName>
    <RootNamespace>DocxHeaderExtractor.Web</RootNamespace>
    <!-- Cần ICU đầy đủ để so sánh chuỗi tiếng Việt không phân biệt hoa thường/dấu -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocxHeaderExtractor.App\DocxHeaderExtractor.App.csproj" />
    <ProjectReference Include="..\DocxHeaderExtractor.Contracts\DocxHeaderExtractor.Contracts.csproj" />
    <ProjectReference Include="..\DocxHeaderExtractor.Sources\DocxHeaderExtractor.Sources.csproj" />
    <ProjectReference Include="..\DocxHeaderExtractor.DocumentProcessing\DocxHeaderExtractor.DocumentProcessing.csproj" />
    <ProjectReference Include="..\DocxHeaderExtractor.Infrastructure\DocxHeaderExtractor.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Web SDK chỉ chép wwwroot khi publish; ta chạy thẳng dll trong bin nên cần chép khi build -->
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
