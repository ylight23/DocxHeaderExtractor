bin/
obj/
*.user
.vs/
.idea/

# Mô hình rất lớn – không đưa vào git
models/*.gguf
models/*.gguf.part

samples/*.docx
!samples/mau.docx
*.log

# Bộ test: giữ đáp án và bộ sinh, KHÔNG giữ tài liệu.
# .docx trong bench/ đều sinh lại được bằng `dhx bench`; riêng tài liệu thật của người dùng
# thì không được đẩy lên — nội dung có thể nhạy cảm.
bench/*.docx
bench/*.doc
!bench/07-mau-that.docx

# data/ là chỗ để tài liệu thật đang thử. Repo này public, mà tài liệu thử thực tế có cả bản
# mang dấu MẬT kèm tên người và số liệu tác chiến — đẩy lên là không thu hồi được, kể cả khi
# xoá commit sau đó. Không có ngoại lệ ở đây.
data/*.docx
data/*.doc
data/*.rtf
data/*.odt

# Holdout thật có thể chứa tài liệu/ngữ cảnh nhạy cảm. Chỉ giữ hướng dẫn, không commit dữ liệu,
# key có comment văn bản hay manifest hash/provenance.
bench/holdout/*
!bench/holdout/README.md

# Review bundle chứa TOÀN VĂN mọi paragraph của tài liệu, không chỉ tiêu đề — nhạy cảm hơn cả
# .docx gốc. File .key chỉ có chỉ số + cấp nên vẫn commit được.
*.review.json
*.training.jsonl

# Bản build GPU tuỳ chọn (dotnet publish -p:UseCuda=true -o out-cuda,
# -p:UseVulkan=true -o out-vulkan / -o out-vulkan-ui)
out-cuda/
out-cuda-ui/
out-vulkan/
out-vulkan-ui/
out-vulkan-next/
out-vulkan-next-cli/
out-mcp/

# Nhãn sinh từ tài liệu thật dùng khi phát triển cục bộ, không đưa lên remote công khai.
bench/09-dien-mat-di.key

.fake

# Đáp án gán nhãn và correction memory mang NGUYÊN VĂN tên đề mục của tài liệu thật.
# Chặn .docx thôi là chưa đủ: nội dung tài liệu rò ra ngoài qua chính các file phái sinh này.
data/*.key
data/*.jsonl
data/*.review.json

# todo10_8/: corpus 95+ tài liệu thật (luật, tài chính, hợp đồng...) dùng để đo tầng 1/2.
# Cùng lý do với data/ ở trên — repo public, không có ngoại lệ.
todo10_8/heading_corpus_95_word/**/*.docx
todo10_8/heading_corpus_95_word/**/*.doc
todo10_8/heading_corpus_95_word/**/*.pdf
todo10_8/heading_corpus_100/**/*.docx
todo10_8/heading_corpus_100/**/*.doc
todo10_8/heading_corpus_100/**/*.pdf

# canon.py/vn_outline.py sinh ra khi chạy thử cục bộ — chứa TOÀN VĂN paragraph
# của tài liệu thật (giống lý do chặn *.review.json ở data/ phía trên).
todo10_8/blocks.json
todo10_8/outline.json
todo10_8/unpacked/
__pycache__/
*.pyc
*.thongke.csv
thongke*.csv
