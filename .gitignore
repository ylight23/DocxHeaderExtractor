bin/
obj/
__pycache__/
*.py[cod]
.verify-build/
*.user
.vs/
.idea/

# Mô hình rất lớn – không đưa vào git
models/*.gguf
models/*.gguf.part

samples/*.docx
!samples/mau.docx
*.log

# Bộ test: giữ đáp án và bộ sinh, KHÔNG giữ tài liệu.
# .docx trong bench/ đều sinh lại được bằng `dhx bench`; riêng tài liệu thật của người dùng
# thì không được đẩy lên — nội dung có thể nhạy cảm.
bench/*.docx
bench/*.doc
!bench/07-mau-that.docx

# data/ là chỗ để tài liệu thật đang thử. Repo này public, mà tài liệu thử thực tế có cả bản
# mang dấu MẬT kèm tên người và số liệu tác chiến — đẩy lên là không thu hồi được, kể cả khi
# xoá commit sau đó. Không có ngoại lệ ở đây.
data/*.docx
data/*.doc
data/*.rtf
data/*.odt

# Holdout thật có thể chứa tài liệu/ngữ cảnh nhạy cảm. Chỉ giữ hướng dẫn, không commit dữ liệu,
# key có comment văn bản hay manifest hash/provenance.
bench/holdout/*
!bench/holdout/README.md

# Review bundle chứa TOÀN VĂN mọi paragraph của tài liệu, không chỉ tiêu đề — nhạy cảm hơn cả
# .docx gốc. File .key chỉ có chỉ số + cấp nên vẫn commit được.
*.review.json
*.training.jsonl

# Bản build GPU tuỳ chọn (dotnet publish -p:UseCuda=true -o out-cuda,
# -p:UseVulkan=true -o out-vulkan / -o out-vulkan-ui)
out-cuda/
out-cuda-ui/
out-vulkan/
out-vulkan-ui/
out-vulkan-next/
out-vulkan-next-cli/
out-mcp/

# Nhãn sinh từ tài liệu thật dùng khi phát triển cục bộ, không đưa lên remote công khai.
bench/09-dien-mat-di.key

.fake

# Bản kết xuất outline — sinh lại được bằng `dhx extract`, không đưa vào repo
outline_out/
outline_llm/

# Cấu hình agent cục bộ. Nó thuộc về máy đang làm việc, không thuộc về mã nguồn:
# skills và worktrees khác nhau giữa các máy, và worktrees còn chứa bản sao repo.
.claude/
.agents/

# Gold visual review workspace: 150 DPI renders of held-out pages; public repo, keep local/private (manifest pins hashes)
artifacts/web-pdf-semantic-diagnostic/p7.f1q.heldout.gold-workspace.*/*.review.html
artifacts/web-pdf-semantic-diagnostic/p7.f1q.heldout.gold-workspace.*/*.review.pdf

# OCR preflight evidence store (page images, TSV): written by `dhx scan-ocr`, never committed
.dhx-evidence/

# Công cụ và dữ liệu thử nghiệm cục bộ có thể chứa nội dung tài liệu thật.
/scratchpad/

# dotnet test output (generated, per run)
tests/DocxHeaderExtractor.Tests/TestResults/

# evidence and source caches written by the pipelines (per run, per source)
.dhx-evidence/

# Build outputs of qualification test runs (binaries only; run results stay visible)
artifacts/qualification/**/*.dll
artifacts/qualification/**/*.pdb
artifacts/qualification/**/*.exe
artifacts/qualification/**/*.deps.json
artifacts/qualification/**/*.runtimeconfig.json

# Published web app copied into qualification runs: native libraries and static pages
artifacts/qualification/**/runtimes/
artifacts/qualification/**/wwwroot/
artifacts/qualification/**/*.so
artifacts/qualification/**/*.dylib
# Office and PDF files used or written by qualification runs (may hold the owner's report text)
artifacts/qualification/**/*.docx
artifacts/qualification/**/*.pdf
artifacts/qualification/**/*.pptx
artifacts/qualification/**/*.odt
# Runs on the owner's monthly reports (their text must never reach the public repo)
artifacts/qualification/monthly-*/
artifacts/qualification/word-incremental-*/
artifacts/qualification/gather-e2e-*/
artifacts/qualification/gather-variance-*/
artifacts/qualification/gather-demo-*/
artifacts/qualification/paired-*/
artifacts/qualification/place-ab-*/
artifacts/qualification/split-numbered-*/
artifacts/qualification/parent-counterfactual-*/
# Word lock files and generated monthly inputs
.~lock.*#
todo10_8/generated-docx-v2/

# Test-host manifests copied into qualification runs
artifacts/qualification/**/MvcTestingAppManifest.json
artifacts/qualification/**/*.staticwebassets.*.json
# Runs on the owner's monthly reports 08/09/10 (source text, model replies, plans)
artifacts/qualification/docx-vn-*/
artifacts/qualification/docx-trace-09-*/
artifacts/qualification/docx-region-09-*/
artifacts/qualification/docx-region-real-probe-*/
artifacts/qualification/gather-replay-*/
artifacts/qualification/admin-web-run-*/
artifacts/qualification/whole-placement-*/
artifacts/qualification/sibling-check-*/
artifacts/qualification/**/*-source-text.txt
todo10_8/standard-docx-v3/
# Private git worktree used for a revert control
artifacts/qualification/docx-cache-revert-control-20261104/
