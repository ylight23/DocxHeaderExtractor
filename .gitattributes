# Freeze artifacts are written by tests and read back by tests, so what checkout puts in the
# working tree must be exactly what a regeneration writes. Left to core.autocrlf, checkout produced
# CRLF on Windows while the writer produced LF; Git then reported the file modified to avoid
# overwriting local work, and `git checkout` and `git bisect` aborted on a clean green run. The
# content was never in question - `git diff` was empty - so pinning the checkout is the fix, not
# changing what the artifacts say.
# Kept to the directories a test regenerates. A wider rule reaches artifacts whose recorded hash
# was taken over a checkout rather than over the committed bytes, and changing what checkout
# produces would silently redefine whether those still verify - a separate question, not this one.
/eval/a99-closed-loop/pdf-canary-072/** text eol=lf
/eval/a99-closed-loop/docx-i8-doc0256/** text eol=lf
/eval/a99-closed-loop/semantic-conflict-frozen-replay/** text eol=lf
/eval/verification/** text eol=lf
/eval/a99-closed-loop/pdf-gold-doc0252/** text eol=lf
/eval/a99-closed-loop/gold-current/** text eol=lf
# One file rather than the directory: its neighbours in representation/ predate this rule and no
# test regenerates them, so widening it would change what their checkout produces to answer a
# question nobody asked.
/eval/a99-closed-loop/representation/doc-0252-source-occurrence-boundary.v1.json text eol=lf
/eval/a99-closed-loop/representation/doc-0252-visual-line-shadow.v1.json text eol=lf
/eval/a99-closed-loop/representation/doc-0252-block-grouping-shadow.v1.json text eol=lf
/eval/a99-closed-loop/representation/doc-0252-visual-line-segment-shadow.v1.json text eol=lf
/eval/a99-closed-loop/representation/visual-line-segment-adjudication.v1.json text eol=lf
/eval/a99-closed-loop/representation/doc-0252-structured-source-parts.v1.json text eol=lf
/eval/a99-closed-loop/representation/doc-0252-segment-evidence-authority.v1.json text eol=lf
/eval/a99-closed-loop/canonical-semantic-gold-vnext/occurrence/DOC-0252.structured-source-parts.occurrence-gold.v1.json text eol=lf

# These benchmark artifacts are bound by raw SHA-256 in N12/N14. Keep their Git blobs byte-identical
# in every checkout; their .json extension does not grant Git permission to rewrite line endings.
/eval/benchmark-n0/silver-labels/*.json -text
/eval/benchmark-n0/census/003-n1.3-census.v1.json -text
/eval/benchmark-n0/census/029-n1.3-census.v1.json -text
/eval/benchmark-n0/census/042-n1.3-census.v1.json -text
/eval/benchmark-n0/census/057-n1.3-census.v1.json -text
# N3.4 binds its one canonical live run and paired offline reports by raw SHA-256.
# Keep this narrow: ordinary JSON remains normal text unless its contract says byte identity.
/eval/benchmark-n3/n3.4/*.json -text
/eval/benchmark-n3/n3.4/*.jsonl -text
/eval/benchmark-n3/n3.4/*.sha256 -text
# Historical D evidence is byte-preserved and not an active text diff surface.
/archive/d-legacy/** -text -diff

# V6 partial forensic snapshot is bound by the manifest's raw SHA-256 values.
/artifacts/level-accuracy/canonical-dev-v1-exec-v6/partial-forensic-snapshot-v2/** -text -diff

# C# source is LF on every checkout. Raw-string prompts take their line endings from the source file,
# and those prompts are serialized into provider bodies whose hashes are frozen; a CRLF checkout must
# not change the wire. QualifiedPromptText.Canonicalize is the second, checkout-independent layer.
*.cs text eol=lf

# Provider capture files are hashed as bytes by the tests that read them, and those hashes were recorded over a Windows
# checkout, where the capture tooling's files have CRLF. Pinning the checkout reproduces exactly those bytes on every host;
# the freeze artifacts the tests themselves write stay LF. Kept to the capture and result files named below.
/artifacts/v5-p6t-function-membership/**/*.raw-capture.v1.json text eol=crlf
/artifacts/v5-p6t-function-membership/**/result.v1.json text eol=crlf
/artifacts/v5-p6t-function-membership/**/retry-src089-result.v1.json text eol=crlf
/artifacts/v5-p6t-function-membership/**/retry-until-accepted-summary.v1.json text eol=crlf
/artifacts/v5-p6t-function-membership/p6th2c-evidence-complete-retry-20261005/execution-reservation.v1.json text eol=crlf
/artifacts/v5-p6t-total-occurrence-role/**/result.v1.json text eol=crlf
# One file whose text a frozen audit hashed as checked out.
/eval/a99-closed-loop/source-review-v1/SRC-095/review-items.json text eol=crlf
# This observed-output inventory was generated as LF and its bytes are referenced by the separate
# provider-free source-review receipt. Preserve those original bytes on every verification host.
/artifacts/web-pdf-semantic-diagnostic/run-1c32edb4.inventory.v1.json text eol=lf
# P7 qualification receipts are immutable raw-hash authorities. Preserve generated bytes
